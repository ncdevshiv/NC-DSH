{
    "name":  "@deepseek-ai/dsh-fs-mcp",
    "description":  "Filesystem provider backed by the nc-tools MCP server",
    "version":  "0.2.1-rc.2",
    "publishConfig":  {
                          "access":  "public"
                      },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/deepseek-ai/deepseek-harness.git",
                       "directory":  "packages/fs/fs-mcp"
                   },
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./src/*":  "./src/*",
