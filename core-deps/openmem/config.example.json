{
  "version": "2.0.0",
  "agent": "auto-detect",
  "llm": {
    "provider": "auto",
    "model": "auto",
    "api_key_env": "AUTO"
  },
  "memory": {
    "db_path": "data/lancedb",
    "embedding_model": "all-MiniLM-L6-v2",
    "embedding_dim": 384,
    "reranker_model": "auto",
    "max_memories": 1000,
    "consolidation_schedule": "auto"
  },
  "learning": {
    "auto_learn": true,
    "interval_hours": 2,
    "enable_skill_generation": true,
    "enable_evolution": false
  },
  "agents": {
    "claude_code": { "enabled": true },
    "codex_cli": { "enabled": true },
    "cursor": { "enabled": true },
    "qwen_code": { "enabled": true },
    "opencode": { "enabled": true },
    "antigravity_ide": { "enabled": true },
    "kilo_cli": { "enabled": true },
    "vscode": { "enabled": true },
    "windsurf": { "enabled": true },
    "openclaw": { "enabled": true },
    "generic": { "enabled": true }
  }
}
