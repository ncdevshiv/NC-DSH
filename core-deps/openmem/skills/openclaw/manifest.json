{
  "name": "lancemem",
  "version": "2.0.0",
  "description": "Autonomous memory system powered by LanceDB for AI agents",
  "author": "LanceMem",
  "commands": [
    "status",
    "install",
    "init",
    "run",
    "search",
    "patterns",
    "skills",
    "stats",
    "profile",
    "optimize",
    "evolve",
    "daemon"
  ],
  "triggers": [
    "/lm",
    "/lancemem",
    "/learn"
  ],
  "skill_path": "skills/openclaw",
  "root": ".",
  "requires": [
    "lancedb>=0.12.0",
    "sentence-transformers>=2.2.0"
  ],
  "optional": [
    "honcho-ai>=1.0.0"
  ],
  "ports": {
    "lance_server": 8080
  },
  "daemon": {
    "default_interval_hours": 2,
    "auto_start": false
  },
  "files": [
    "learner.py",
    "SKILL.md",
    "manifest.json"
  ],
  "manifest_version": "1.0"
}
