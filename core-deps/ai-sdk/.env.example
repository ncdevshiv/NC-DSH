# AI SDK environment template — copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real keys.
#
# Every variable below is READ BY THE SDK (crates/ai-config/src/lib.rs,
# env_keys module) unless marked otherwise.

# ─────────────────────────────────────────────────────────────────────────────
# PROVIDER — which configured provider to use when a model reference has no
# provider prefix. One of: opencode | openai | anthropic | google |
# openrouter | ollama
AI_SDK_PROVIDER=opencode

# ─────────────────────────────────────────────────────────────────────────────
# BASE URL + API KEY — OpenAI-compatible gateway (project default).
# Registered under the provider id `opencode`.
AI_SDK_GATEWAY_BASE_URL=https://opencode.ai/zen/go/v1
AI_SDK_GATEWAY_API_KEY=sk-your-key-here

# ─────────────────────────────────────────────────────────────────────────────
# MODEL IDs
# Primary chat model (also stored as the `opencode` provider's default model).
AI_SDK_PRIMARY_MODEL=deepseek-v4-flash
# Vision-capable model (used by live tests and vision examples).
AI_SDK_VISION_MODEL=mimo-v2.5

# ─────────────────────────────────────────────────────────────────────────────
# CONTEXT LENGTH — context window of the primary model, in TOKENS.
# Surfaced via Config::primary_model_context_length so apps/agents can budget
# prompts instead of hardcoding it.
AI_SDK_PRIMARY_MODEL_CONTEXT_LENGTH=131072

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL CALL DEFAULTS
# AI_SDK_DEFAULT_TIMEOUT=30      # seconds per call
# AI_SDK_MAX_RETRIES=2           # transient-failure retries

# ─────────────────────────────────────────────────────────────────────────────
# STANDARD PROVIDERS — set the ones you use instead of (or alongside) the
# gateway. Keys register under their provider ids automatically.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ─────────────────────────────────────────────────────────────────────────────
# CONFIG FILE (optional, TOML): point at an explicit file, or drop a
# `.ai-sdk.toml` next to your binary. Env vars always win over file values.
# AI_SDK_CONFIG=/path/to/ai-sdk.toml
#
# Example `.ai-sdk.toml`:
#   [defaults]
#   timeout_secs = 60
#   max_retries = 3
#
#   [providers.openai]
#   api_key = "sk-..."
#   default_model = "gpt-4o"
